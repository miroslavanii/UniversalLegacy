local function createSetting(parent, name, detail, key, order, callback)
    local button = Instance.new("TextButton")
    button.Name = key .. "Toggle"
    button.Size = UDim2.new(1, -4, 0, 48)
    button.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    button.BackgroundTransparency = 0.2
    button.Text = ""
    button.BorderSizePixel = 0
    button.LayoutOrder = order
    button.Parent = parent
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.68, 0, 0, 22)
    label.Position = UDim2.fromOffset(10, 3)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = button

    local sub = Instance.new("TextLabel")
    sub.Size = UDim2.new(0.72, 0, 0, 16)
    sub.Position = UDim2.fromOffset(10, 26)
    sub.BackgroundTransparency = 1
    sub.Text = detail
    sub.TextColor3 = Color3.fromRGB(150, 150, 150)
    sub.TextSize = 10
    sub.Font = Enum.Font.Gotham
    sub.TextXAlignment = Enum.TextXAlignment.Left
    sub.Parent = button

    local state = Instance.new("TextLabel")
    state.Size = UDim2.fromOffset(65, 28)
    state.Position = UDim2.new(1, -75, 0.5, -14)
    state.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    state.TextColor3 = Color3.new(1, 1, 1)
    state.TextSize = 11
    state.Font = Enum.Font.GothamBold
    state.BorderSizePixel = 0
    state.Parent = button
    Instance.new("UICorner", state).CornerRadius = UDim.new(0, 6)

    local function update()
        state.Text = settings[key] and "ON" or "OFF"
        tween(state, 0.15, nil, nil, {
            BackgroundColor3 = settings[key]
                and Color3.fromRGB(0, 150, 70)
                or Color3.fromRGB(35, 35, 35)
        })
    end

    button.Activated:Connect(function()
        settings[key] = not settings[key]
        update()
        if callback then
            callback(settings[key])
        else
            refreshESP()
        end
    end)

    update()
end

