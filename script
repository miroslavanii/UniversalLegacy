local function addESP(target)
    if not settings.Enabled or target == player or destroyed then return end

    local character = target.Character
    if not character then
        removeESP(target)
        return
    end

    local current = espObjects[target]
    if current and current.character == character then
        if current.highlight then
            current.highlight.Enabled = settings.Highlights
            current.highlight.FillTransparency = settings.Fill and 0.5 or 1
            current.highlight.OutlineTransparency = settings.Outline and 0 or 1
            current.highlight.FillColor = settings.FillColor
            current.highlight.OutlineColor = settings.OutlineColor
        end
        if current.nameTag then
            current.nameTag.Enabled = settings.Names
        end
        if (settings.Names and not current.nameTag)
            or (settings.Highlights and not current.highlight) then
            removeESP(target)
        else
            return
        end
    end

    removeESP(target)

    local objects = {character = character}

    if settings.Highlights then
        local highlight = Instance.new("Highlight")
        highlight.Name = "PlayerESP"
        highlight.Adornee = character
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = settings.FillColor
        highlight.OutlineColor = settings.OutlineColor
        highlight.FillTransparency = settings.Fill and 0.5 or 1
        highlight.OutlineTransparency = settings.Outline and 0 or 1
        highlight.Parent = screenGui
        objects.highlight = highlight
    end

    if settings.Names then
        local head = character:FindFirstChild("Head")
        if head then
            local tag = Instance.new("BillboardGui")
            tag.Name = "ESPName"
            tag.Adornee = head
            tag.Size = UDim2.fromOffset(200, 32)
            tag.StudsOffset = Vector3.new(0, 2.5, 0)
            tag.AlwaysOnTop = true
            tag.Parent = screenGui

            local label = Instance.new("TextLabel")
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundTransparency = 1
            label.Text = target.DisplayName .. " (@" .. target.Name .. ")"
            label.TextColor3 = Color3.new(1, 1, 1)
            label.TextStrokeColor3 = Color3.new(0, 0, 0)
            label.TextStrokeTransparency = 0
            label.TextScaled = true
            label.Font = Enum.Font.GothamBold
            label.Parent = tag

            objects.nameTag = tag
        end
    end

    espObjects[target] = objects
end

local function refreshESP()
    espButton.Text = settings.Enabled and "PLAYER ESP: ON" or "PLAYER ESP: OFF"

    tween(espButton, 0.15, nil, nil, {
        BackgroundColor3 = settings.Enabled
            and Color3.fromRGB(0, 150, 70)
            or Color3.fromRGB(20, 20, 20)
    })

    for _, target in Players:GetPlayers() do
        if target ~= player then
            if settings.Enabled then
                addESP(target)
            else
                removeESP(target)
            end
        end
    end
end

espButton.Activated:Connect(function()
    settings.Enabled = not settings.Enabled
    refreshESP()
end)

