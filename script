-- ANIMATED POP-UP MODAL FUNCTIONS
local modalAnimating = false

local function showModal()
    if modalAnimating or warningModal.Visible then return end
    modalAnimating = true
    
    warningModal.GroupTransparency = 1
    modalScale.Scale = 0.8
    warningModal.Visible = true

    tween(warningModal, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {GroupTransparency = 0})
    local scaleTw = tween(modalScale, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {Scale = 1})
    
    scaleTw.Completed:Wait()
    modalAnimating = false
end

local function hideModal()
    if modalAnimating or not warningModal.Visible then return end
    modalAnimating = true

    tween(warningModal, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {GroupTransparency = 1})
    local scaleTw = tween(modalScale, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {Scale = 0.8})

    scaleTw.Completed:Wait()
    warningModal.Visible = false
    modalAnimating = false
end

-- ESP MANAGEMENT
local function removeESP(target)
    local objects = espObjects[target]
    if objects then
        if objects.highlight then
            objects.highlight:Destroy()
        end
        if objects.nameTag then
            objects.nameTag:Destroy()
        end
        espObjects[target] = nil
    end
end

-- PERMANENT DESTROY FUNCTION
local function destroyGUI()
    if destroyed then return end
    destroyed = true

    stopNoclip()
    stopFly()
    stopSpeedHack()

    for target in pairs(espObjects) do
        removeESP(target)
    end

    tween(main, CLOSE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {GroupTransparency = 1})
    local scaleTween = tween(uiScale, CLOSE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {Scale = 0.85})
    scaleTween.Completed:Wait()

    screenGui:Destroy()
end

closeButton.Activated:Connect(showModal)
cancelBtn.Activated:Connect(hideModal)
confirmBtn.Activated:Connect(destroyGUI)

-- OPEN/CLOSE ANIMATIONS
local function openGUI()
    if animating or isOpen or destroyed then return end
    animating = true
    isOpen = true

    main.Visible = true
    main.GroupTransparency = 1
    uiScale.Scale = 0.85

    tween(main, OPEN_TIME, Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out, {GroupTransparency = 0})

    local scaleTween = tween(uiScale, OPEN_TIME,
        Enum.EasingStyle.Back, Enum.EasingDirection.Out,
        {Scale = 1})

    scaleTween.Completed:Wait()
    animating = false
end

local function closeGUI()
    if animating or not isOpen or destroyed then return end
    animating = true
    isOpen = false

    tween(main, CLOSE_TIME, Enum.EasingStyle.Quad,
        Enum.EasingDirection.In, {GroupTransparency = 1})

    local scaleTween = tween(uiScale, CLOSE_TIME,
        Enum.EasingStyle.Quad, Enum.EasingDirection.In,
        {Scale = 0.85})

    scaleTween.Completed:Wait()
    main.Visible = false
    animating = false
end

local function toggleGUI()
    if animating or destroyed then return end
    if isOpen then
        task.spawn(closeGUI)
    else
        task.spawn(openGUI)
    end
end

